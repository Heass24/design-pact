{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "approval_id",
    "schema_version",
    "kind",
    "subject_type",
    "subject_id",
    "subject_path",
    "subject_sha256",
    "decision",
    "author",
    "approver",
    "decided_at",
    "rationale"
  ],
  "properties": {
    "approval_id": {"type": "string", "pattern": "^APR-(?!000)[0-9]{3,}$"},
    "schema_version": {"const": "1.0"},
    "kind": {
      "enum": [
        "scope",
        "design_contract",
        "visual_baseline",
        "exception",
        "release",
        "tdd_event",
        "artifact"
      ]
    },
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "subject_path": {"type": "string", "minLength": 1},
    "subject_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {"enum": ["approved", "rejected"]},
    "author": {"type": "string", "minLength": 1},
    "approver": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(?i)(?:^|[\\s_.:/-])(?:ai|agent|bot|automation|todo|tbd|placeholder|unknown)(?:$|[\\s_.:/-])"
      }
    },
    "decided_at": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1}
  },
  "dependentRequired": {
    "kind": ["subject_type"],
    "subject_id": ["kind", "subject_type", "subject_path", "subject_sha256"],
    "decided_at": ["approver", "author"],
    "rationale": ["decision", "approver"]
  },
  "additionalProperties": true
}
