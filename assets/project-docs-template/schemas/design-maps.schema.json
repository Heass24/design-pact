{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Pact design map collections",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "figma_node_id",
          "compose_path",
          "compose_symbol",
          "screen_ids",
          "state_ids"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^COMP-(?!000)[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "figma_node_id": {"type": "string", "minLength": 1},
          "compose_path": {"type": "string", "minLength": 1},
          "compose_symbol": {"type": "string", "minLength": 1},
          "screen_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(SCREEN|FLOW)-(?!000)[0-9]{3}$"}
          },
          "state_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"}
          }
        },
        "additionalProperties": true
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "semantic_name",
          "figma_variable_name",
          "value_type",
          "value"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^TOKEN-(?!000)[0-9]{3}$"},
          "semantic_name": {"type": "string", "minLength": 1},
          "figma_variable_name": {"type": "string", "minLength": 1},
          "value_type": {
            "enum": ["color", "typography", "spacing", "shape", "motion", "elevation"]
          },
          "value": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "figma_node_id",
          "path",
          "sha256",
          "format",
          "license"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^ASSET-(?!000)[0-9]{3}$"},
          "figma_node_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "format": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "affected_ids",
          "figma_source",
          "rationale",
          "approval_id",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^EXC-(?!000)[0-9]{3}$"},
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "figma_source": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "approval_id": {"type": "string"},
          "status": {"enum": ["proposed", "approved", "rejected"]}
        },
        "additionalProperties": true
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "blocker_class",
          "affected_ids",
          "owner",
          "required_input",
          "recovery_condition",
          "status"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^GAP-(?!000)[0-9]{3}$"},
          "blocker_class": {
            "enum": [
              "blocked_by_design",
              "blocked_by_product",
              "blocked_by_content",
              "blocked_by_asset",
              "blocked_by_platform"
            ]
          },
          "affected_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "owner": {"type": "string", "minLength": 1},
          "required_input": {"type": "string", "minLength": 1},
          "recovery_condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "resolved", "rejected"]},
          "approval_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
