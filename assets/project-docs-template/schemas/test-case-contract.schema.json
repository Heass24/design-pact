{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Pact test-case contract",
  "type": "object",
  "required": ["slice_id", "slice_type", "spec_id", "tests"],
  "properties": {
    "slice_id": {"type": "string", "pattern": "^(SCREEN|FLOW)-(?!000)[0-9]{3}$"},
    "slice_type": {"enum": ["screen", "flow"]},
    "spec_id": {"type": "string", "pattern": "^SPEC-(?!000)[0-9]{3}$"},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "ac_ids",
          "state_ids",
          "title",
          "test_type",
          "priority",
          "planning_status",
          "precondition",
          "test_data",
          "action",
          "expected",
          "accessibility_assertions",
          "visual_shot_ids"
        ],
        "properties": {
          "test_id": {"type": "string", "pattern": "^TEST-(?!000)[0-9]{3}$"},
          "ac_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^AC-(?!000)[0-9]{3}$"}
          },
          "state_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"}
          },
          "title": {"type": "string", "minLength": 1},
          "test_type": {
            "enum": [
              "unit",
              "component",
              "ui",
              "integration",
              "visual",
              "accessibility"
            ]
          },
          "priority": {"type": "string", "pattern": "^P[0-3]$"},
          "planning_status": {
            "enum": ["planned", "active", "blocked", "deferred", "out_of_scope"]
          },
          "precondition": {"type": "string", "minLength": 1},
          "test_data": {
            "type": "array",
            "items": {"type": "string"}
          },
          "action": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "accessibility_assertions": {
            "type": "array",
            "items": {"type": "string"}
          },
          "visual_shot_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^SHOT-(?!000)[0-9]{3}$"}
          },
          "implementation_path": {"type": "string", "minLength": 1},
          "implementation_symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "planning_reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "planning_status": {"enum": ["planned", "active"]}
              },
              "required": ["planning_status"]
            },
            "then": {
              "required": ["implementation_path", "implementation_symbol"]
            }
          },
          {
            "if": {
              "properties": {
                "planning_status": {
                  "enum": ["blocked", "deferred", "out_of_scope"]
                }
              },
              "required": ["planning_status"]
            },
            "then": {
              "required": ["planning_reason"]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {"slice_type": {"const": "screen"}},
        "required": ["slice_type"]
      },
      "then": {
        "properties": {
          "slice_id": {
            "type": "string",
            "pattern": "^SCREEN-(?!000)[0-9]{3}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"slice_type": {"const": "flow"}},
        "required": ["slice_type"]
      },
      "then": {
        "properties": {
          "slice_id": {
            "type": "string",
            "pattern": "^FLOW-(?!000)[0-9]{3}$"
          }
        }
      }
    }
  ]
}
