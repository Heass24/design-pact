{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["screens", "flows", "states"],
  "properties": {
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "feature_ids",
          "state_ids",
          "figma"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^SCREEN-(?!000)[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^FEAT-(?!000)[0-9]{3}$"}
          },
          "state_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"}
          },
          "figma": {"$comment": "Validated by validate_scope.py", "type": "object"}
        },
        "additionalProperties": true
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "feature_ids", "state_ids", "figma"],
        "properties": {
          "id": {"type": "string", "pattern": "^FLOW-(?!000)[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^FEAT-(?!000)[0-9]{3}$"}
          },
          "state_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"}
          },
          "figma": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "screen_id", "name", "figma"],
        "properties": {
          "id": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"},
          "screen_id": {
            "type": "string",
            "pattern": "^(SCREEN|FLOW)-(?!000)[0-9]{3}$"
          },
          "name": {"type": "string", "minLength": 1},
          "figma": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
