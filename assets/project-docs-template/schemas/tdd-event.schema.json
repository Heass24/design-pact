{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "spec_id",
    "ac_ids",
    "test_id",
    "phase",
    "command",
    "exit_code",
    "started_at",
    "finished_at",
    "actor",
    "artifact_path",
    "artifact_sha256",
    "test_declaration_sha256",
    "contract_sha256",
    "implementation_path",
    "implementation_sha256",
    "status",
    "prev_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^TDD-(?!000)[0-9]{3,}$"},
    "schema_version": {"const": "1.0"},
    "spec_id": {"type": "string", "pattern": "^SPEC-(?!000)[0-9]{3}$"},
    "ac_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^AC-(?!000)[0-9]{3}$"}
    },
    "test_id": {"type": "string", "pattern": "^TEST-(?!000)[0-9]{3}$"},
    "phase": {"enum": ["red", "green", "refactor", "verify"]},
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "exit_code": {"type": "integer"},
    "failure_kind": {"type": ["string", "null"]},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_declaration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation_path": {"type": "string", "minLength": 1},
    "implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {"const": "captured"},
    "prev_event_sha256": {
      "type": "string",
      "pattern": "^(|[0-9a-f]{64})$"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
