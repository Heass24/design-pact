{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Pact L1 or L2 specification frontmatter",
  "type": "object",
  "required": [
    "spec_id",
    "spec_level",
    "journey_ids",
    "feature_ids",
    "state_ids"
  ],
  "properties": {
    "spec_id": {"type": "string", "pattern": "^SPEC-(?!000)[0-9]{3}$"},
    "spec_level": {"enum": ["L1", "L2"]},
    "journey_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^JRN-(?!000)[0-9]{3}$"}
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^FEAT-(?!000)[0-9]{3}$"}
    },
    "screen_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SCREEN-(?!000)[0-9]{3}$"}
    },
    "flow_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^FLOW-(?!000)[0-9]{3}$"}
    },
    "state_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"}
    },
    "ac_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AC-(?!000)[0-9]{3}$"}
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state_id",
          "title",
          "given",
          "when",
          "then",
          "test_ids",
          "visual_required"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-(?!000)[0-9]{3}$"},
          "state_id": {"type": "string", "pattern": "^STATE-(?!000)[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "given": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1},
          "test_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^TEST-(?!000)[0-9]{3}$"}
          },
          "visual_required": {"type": "boolean"},
          "visual_shot_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^SHOT-(?!000)[0-9]{3}$"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {"spec_level": {"const": "L2"}},
        "required": ["spec_level"]
      },
      "then": {
        "required": [
          "screen_ids",
          "flow_ids",
          "journey_ids",
          "feature_ids",
          "state_ids",
          "ac_ids"
        ],
        "properties": {
          "ac_ids": {
            "type": "array",
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "required": ["screen_ids"],
            "properties": {
              "screen_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "required": ["flow_ids"],
            "properties": {
              "flow_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ]
}
