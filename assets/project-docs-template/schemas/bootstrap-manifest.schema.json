{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Pact bootstrap build evidence",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_version",
    "version",
    "owner",
    "created_at_state",
    "status",
    "source_ids",
    "upstream_sha256",
    "approval_required",
    "created_at",
    "project",
    "toolchain",
    "commands",
    "conclusion"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-(?!000)[0-9]{3}$"
    },
    "artifact_type": {"const": "bootstrap_manifest"},
    "schema_version": {"const": "1.0"},
    "version": {"type": "integer", "minimum": 1},
    "owner": {"type": "string", "minLength": 1},
    "created_at_state": {"const": "discovery"},
    "status": {"const": "draft"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "upstream_sha256": {"type": "string"},
    "approval_required": {"const": false},
    "created_at": {"type": "string", "minLength": 1},
    "project": {
      "type": "object",
      "required": ["app_name", "package_name", "display_name", "state"],
      "properties": {
        "app_name": {"type": "string", "minLength": 1},
        "package_name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "state": {"const": "discovery"}
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": ["java", "android_sdk", "gradle"],
      "properties": {
        "java": {"type": "string", "minLength": 1},
        "android_sdk": {"type": "string", "minLength": 1},
        "gradle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "argv", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "status": {"enum": ["passed", "failed", "not_run"]},
          "exit_code": {"type": "integer"},
          "launch_error": {"type": "string", "minLength": 1},
          "started_at": {"type": "string"},
          "finished_at": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "log_path": {"type": "string"},
          "log_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "conclusion": {"enum": ["pass", "fail"]}
  },
  "additionalProperties": false
}
