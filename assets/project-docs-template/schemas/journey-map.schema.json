{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["journeys"],
  "properties": {
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "feature_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^JRN-(?!000)[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "feature_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^FEAT-(?!000)[0-9]{3}$"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
